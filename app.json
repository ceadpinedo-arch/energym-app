{
  "expo": {
    "extra": {
      "eas": {
        "projectId": "0fe1996e-72ae-4dd2-b78d-3fd5d55b3eca"
      }
    },
    "android": {
      "package": "ar.com.tuaccesogym.app",
      "versionCode": 1,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ECFDF5"
      }
    },
    "plugins": [
      "expo-font",
      "expo-asset",
      [
        "expo-camera",
        {
          "cameraPermission": "TuAccesoGym necesita la cámara para escanear el QR de acceso al gimnasio."
        }
      ],
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ECFDF5"
        }
      ]
    ],
    "name": "TuAccesoGym",
    "version": "1.0.0",
    "slug": "energym-app",
    "icon": "./assets/icon.png"
  }
}